            ],
            "Condition": {
              "StringEquals": {
                "aws:RequestTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "RdsTagOnCreate",
            "Effect": "Allow",
            "Action": "rds:AddTagsToResource",
            "Resource": [
              "arn:aws:rds:*:${aws:PrincipalAccount}:db:lf-*",
              "arn:aws:rds:*:${aws:PrincipalAccount}:pg:lf-*",
              "arn:aws:rds:*:${aws:PrincipalAccount}:subgrp:lf-*"
            ],
            "Condition": {
              "StringEquals": {
                "aws:RequestTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "RdsChangeTagged",
            "Effect": "Allow",
            "Action": [
              "rds:AddTagsToResource",
              "rds:CreateDBInstance",
              "rds:DeleteDBInstance",
              "rds:DeleteDBParameterGroup",
              "rds:DeleteDBSubnetGroup",
              "rds:DescribeDBInstances",
              "rds:DescribeDBParameterGroups",
              "rds:DescribeDBParameters",
              "rds:DescribeDBSubnetGroups",
              "rds:ListTagsForResource",
              "rds:ModifyDBInstance",
              "rds:ModifyDBParameterGroup",
              "rds:ModifyDBSubnetGroup",
              "rds:RemoveTagsFromResource",
              "rds:ResetDBParameterGroup"
            ],
            "Resource": [
              "arn:aws:rds:*:${aws:PrincipalAccount}:db:lf-*",
              "arn:aws:rds:*:${aws:PrincipalAccount}:pg:lf-*",
              "arn:aws:rds:*:${aws:PrincipalAccount}:subgrp:lf-*"
            ],
            "Condition": {
              "StringEquals": {
                "aws:ResourceTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "RdsByName",
            "Effect": "Allow",
            "Action": [
              "rds:CreateDBInstance",
              "rds:DescribeDBClusters",
              "rds:ListTagsForResource"
            ],
            "Resource": "arn:aws:rds:*:${aws:PrincipalAccount}:cluster:*"
          },
          {
            "Sid": "RdsFinalSnapshot",
            "Effect": "Allow",
            "Action": "rds:CreateDBSnapshot",
            "Resource": "arn:aws:rds:*:${aws:PrincipalAccount}:snapshot:lf-*"
          },
          {
            "Sid": "RdsFinalSnapshotOfInstance",
            "Effect": "Allow",
            "Action": "rds:CreateDBSnapshot",
            "Resource": "arn:aws:rds:*:${aws:PrincipalAccount}:db:lf-*",
            "Condition": {
              "StringEquals": {
                "aws:ResourceTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "RdsManagedSecret",
            "Effect": "Allow",
            "Action": [
              "secretsmanager:CreateSecret",
              "secretsmanager:TagResource"
            ],
            "Resource": "arn:aws:secretsmanager:*:${aws:PrincipalAccount}:secret:rds!*"
          }
        ]
      }
    },
