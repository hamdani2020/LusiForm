          {
            "Sid": "Ec2CreateTagged",
            "Effect": "Allow",
            "Action": [
              "ec2:CreateFlowLogs",
              "ec2:CreateInternetGateway",
              "ec2:CreateRouteTable",
              "ec2:CreateSecurityGroup",
              "ec2:CreateSubnet",
              "ec2:CreateVpc"
            ],
            "Resource": [
              "arn:aws:ec2:*:${aws:PrincipalAccount}:internet-gateway/*",
              "arn:aws:ec2:*:${aws:PrincipalAccount}:route-table/*",
              "arn:aws:ec2:*:${aws:PrincipalAccount}:security-group/*",
              "arn:aws:ec2:*:${aws:PrincipalAccount}:subnet/*",
              "arn:aws:ec2:*:${aws:PrincipalAccount}:vpc-flow-log/*",
              "arn:aws:ec2:*:${aws:PrincipalAccount}:vpc/*"
            ],
            "Condition": {
              "StringEquals": {
                "aws:RequestTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "Ec2TagOnCreate",
            "Effect": "Allow",
            "Action": "ec2:CreateTags",
