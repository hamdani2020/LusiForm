            "Resource": "arn:aws:kms:*:${aws:PrincipalAccount}:alias/lf-*"
          },
          {
            "Sid": "KmsReadAny",
            "Effect": "Allow",
            "Action": "kms:ListAliases",
            "Resource": "*"
          },
          {
            "Sid": "RdsCreateKeyGrant",
            "Effect": "Allow",
            "Action": "kms:CreateGrant",
            "Resource": "arn:aws:kms:*:${aws:PrincipalAccount}:key/*",
            "Condition": {
              "Bool": {
                "kms:GrantIsForAWSResource": "true"
              },
              "StringEquals": {
                "aws:ResourceTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "RdsDescribeManagedSecretKey",
            "Effect": "Allow",
            "Action": "kms:DescribeKey",
            "Resource": "arn:aws:kms:*:${aws:PrincipalAccount}:key/*",
            "Condition": {
              "ForAnyValue:StringEquals": {
                "kms:ResourceAliases": "alias/aws/secretsmanager"
              }
            }
          }
        ]
      }
    },
    {
      "name": "part4",
      "services": [
        "cloudwatch"
      ],
      "characters": 1045,
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "CloudWatchCreateTagged",
            "Effect": "Allow",
            "Action": "cloudwatch:PutMetricAlarm",
            "Resource": "arn:aws:cloudwatch:*:${aws:PrincipalAccount}:alarm:lf-*",
            "Condition": {
              "StringEquals": {
                "aws:RequestTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "CloudWatchTagOnCreate",
            "Effect": "Allow",
            "Action": "cloudwatch:TagResource",
            "Resource": "arn:aws:cloudwatch:*:${aws:PrincipalAccount}:alarm:lf-*",
            "Condition": {
              "StringEquals": {
                "aws:RequestTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "CloudWatchChangeTagged",
            "Effect": "Allow",
            "Action": [
              "cloudwatch:DeleteAlarms",
              "cloudwatch:DescribeAlarms",
              "cloudwatch:ListTagsForResource",
              "cloudwatch:TagResource",
              "cloudwatch:UntagResource"
            ],
            "Resource": "arn:aws:cloudwatch:*:${aws:PrincipalAccount}:alarm:lf-*",
            "Condition": {
              "StringEquals": {
                "aws:ResourceTag/lusiform-managed": "true"
              }
            }
          },
          {
            "Sid": "AutoScalingAlarmValidation",
            "Effect": "Allow",
            "Action": [
              "cloudwatch:DeleteAlarms",
              "cloudwatch:DescribeAlarms",
              "cloudwatch:PutMetricAlarm"
            ],
