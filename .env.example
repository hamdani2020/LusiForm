# Copy to .env (git-ignored) to override. These are local-dev-only values;
# never put real credentials here. Local dev must not use real sandbox credentials.
POSTGRES_USER=lusiform
POSTGRES_PASSWORD=lusiform_local_dev
POSTGRES_DB=lusiform

# LocalStack accepts any credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Optional: DNS server used during image builds when Docker's default resolver
# is unreliable (for example BUILD_DNS=1.1.1.1). Leave empty for the default.
BUILD_DNS=

# Cognito user pool the API verifies tokens against. Not secrets. Leave empty locally
# unless you point at a dev pool; protected routes return 503 while these are unset.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Web sign-in: Cognito hosted UI domain (https) and a PUBLIC app client id (no secret;
# the web app uses authorization code + PKCE). Add http://localhost:5173/auth/callback as an
# allowed callback URL and http://localhost:5173/ as a sign-out URL on the app client.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
