# Secrets and local config (never commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.*.json

# Local MCP config (holds an access token)
.kiro/settings/mcp.json

# OS and editor
.DS_Store
.idea/
.vscode/
*.swp

# Node / web
node_modules/
web/dist/
web/.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Python / api / worker
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/

# Terraform
**/.terraform/
# Shared provider download cache used by the template tests (templates/tests)
templates/.tf-plugin-cache/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.tfvars
!*.tfvars.example
# Terraform backend settings (state bucket); copy from backend.hcl.example
infra/envs/*/backend.hcl
# Keep the provider lock file committed
!.terraform.lock.hcl

# Local artifacts
*.zip
tmp/
.agents/
.worktrees/
